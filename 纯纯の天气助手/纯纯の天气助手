(function (Scratch) {
    'use strict';

    class WeatherAssistantExtension {
        constructor() {
            this.apiKey = '4a0a635c6b151aa111ad78da530048c8';  // 直接使用你的 API Key
            this.baseUrl = 'https://api.openweathermap.org/data/2.5/weather';
            this.units = 'metric';                 // metric: 摄氏度, imperial: 华氏度
            this.tempUnit = '°C';
            this.windUnit = 'm/s';
            this.currentWeather = null;
            this.apiUsage = { limit: 60, remaining: 60, resetTime: 0 };
            this.docsUrl = 'https://learn.ccw.site/article/bedf94cb-5523-457e-9be9-4d3c55671f1d';

            // 缓存：{ cityKey: { data, timestamp } }
            this.cache = new Map();
            this.CACHE_DURATION = 5 * 60 * 1000;   // 5分钟缓存
            this.TIMEOUT = 8000;                   // 8秒超时
        }

        getInfo() {
            return {
                id: 'weather',
                name: '至乐の天气助手',
                color1: '#00bbff',
                docsURI: this.docsUrl,
                blocks: [
                    // --- 基础积木 ---
                    {
                        opcode: 'getWeather',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的天气',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'beijing' } }
                    },
                    {
                        opcode: 'getTemperature',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的温度',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'shanghai' } }
                    },
                    {
                        opcode: 'getFeelsLike',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的体感温度',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'guangzhou' } }
                    },
                    {
                        opcode: 'getWeatherCondition',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的天气状况',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'shenzhen' } }
                    },
                    {
                        opcode: 'getWeatherIcon',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的天气图标代码',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'hangzhou' } }
                    },
                    {
                        opcode: 'getWindSpeed',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的风速',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'chengdu' } }
                    },
                    {
                        opcode: 'getHumidity',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的湿度 (%)',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'wuhan' } }
                    },
                    {
                        opcode: 'getPressure',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的气压 (hPa)',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'nanjing' } }
                    },
                    {
                        opcode: 'getVisibility',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的能见度 (米)',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'xian' } }
                    },
                    {
                        opcode: 'getSunrise',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的日出时间',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'hangzhou' } }
                    },
                    {
                        opcode: 'getSunset',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的日落时间',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'hangzhou' } }
                    },
                    {
                        opcode: 'checkWeatherAlert',
                        blockType: Scratch.BlockType.BOOLEAN,
                        text: '[CITY] 有天气警报吗？',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'fuzhou' } }
                    },
                    {
                        opcode: 'getRemainingQuota',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取今日剩余请求次数'
                    },
                    // --- 高级积木 ---
                    {
                        opcode: 'getFullWeatherData',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取 [CITY] 的所有天气数据 (JSON)',
                        arguments: { CITY: { type: Scratch.ArgumentType.STRING, defaultValue: 'beijing' } }
                    },
                    {
                        opcode: 'getWeatherByIP',
                        blockType: Scratch.BlockType.REPORTER,
                        text: '获取当前城市的天气'
                    },
                    // --- 配置积木（仅保留单位切换）---
                    {
                        opcode: 'setTemperatureUnit',
                        blockType: Scratch.BlockType.COMMAND,
                        text: '设置温度单位为 [UNIT]',
                        arguments: {
                            UNIT: {
                                type: Scratch.ArgumentType.STRING,
                                menu: 'tempUnitMenu',
                                defaultValue: '摄氏度'
                            }
                        }
                    }
                ],
                menus: {
                    tempUnitMenu: {
                        acceptReporters: true,
                        items: ['摄氏度', '华氏度']
                    }
                }
            };
        }

        onInit() {
            const button = document.createElement('button');
            button.textContent = '查看文档';
            Object.assign(button.style, {
                position: 'absolute',
                bottom: '10px',
                right: '10px',
                padding: '8px 16px',
                backgroundColor: '#4CAF50',
                color: '#fff',
                border: 'none',
                borderRadius: '4px',
                cursor: 'pointer',
                zIndex: '1000'
            });
            button.addEventListener('click', () => window.open(this.docsUrl, '_blank'));
            const gui = document.querySelector('.scratch-gui');
            if (gui) gui.appendChild(button);
        }

        // ----------------- 工具方法 -----------------
        cleanCache() {
            const now = Date.now();
            for (const [key, value] of this.cache) {
                if (now - value.timestamp > this.CACHE_DURATION) {
                    this.cache.delete(key);
                }
            }
        }

        async fetchWeatherData(city) {
            const normalizedCity = city.toString().trim();
            if (!normalizedCity) {
                throw new Error('城市名不能为空');
            }

            this.cleanCache();
            const cacheKey = `${normalizedCity}_${this.units}`;
            if (this.cache.has(cacheKey)) {
                const cached = this.cache.get(cacheKey);
                if (Date.now() - cached.timestamp < this.CACHE_DURATION) {
                    return cached.data;
                }
            }

            const url = `${this.baseUrl}?q=${encodeURIComponent(normalizedCity)}&appid=${this.apiKey}&units=${this.units}&lang=zh_cn`;

            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), this.TIMEOUT);

            try {
                const response = await fetch(url, { signal: controller.signal });

                this.updateApiUsage(response.headers);

                if (response.status === 401) {
                    throw new Error('API Key 无效，请检查设置');
                }
                if (response.status === 404) {
                    throw new Error(`未找到城市“${normalizedCity}”`);
                }
                if (response.status === 429) {
                    throw new Error('请求过于频繁，请稍后再试');
                }
                if (!response.ok) {
                    throw new Error(`服务器错误 (${response.status})`);
                }

                const data = await response.json();
                this.cache.set(cacheKey, { data, timestamp: Date.now() });
                this.currentWeather = data;
                return data;
            } catch (err) {
                if (err.name === 'AbortError') {
                    throw new Error('请求超时，请检查网络或稍后重试');
                }
                throw err;
            } finally {
                clearTimeout(timeoutId);
            }
        }

        updateApiUsage(headers) {
            if (headers.has('X-RateLimit-Limit')) {
                this.apiUsage.limit = parseInt(headers.get('X-RateLimit-Limit'), 10);
            }
            if (headers.has('X-RateLimit-Remaining')) {
                this.apiUsage.remaining = parseInt(headers.get('X-RateLimit-Remaining'), 10);
            }
            if (headers.has('X-RateLimit-Reset')) {
                this.apiUsage.resetTime = parseInt(headers.get('X-RateLimit-Reset'), 10);
            }
        }

        async safeGetCityData(city, onSuccess, errorReturn = '无法获取数据') {
            try {
                const data = await this.fetchWeatherData(city);
                return onSuccess(data);
            } catch (e) {
                console.warn('天气助手错误:', e.message);
                return errorReturn;
            }
        }

        formatTime(timestamp) {
            const date = new Date(timestamp * 1000);
            return date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false });
        }

        // ----------------- 积木实现 -----------------
        async getWeather(args) {
            return this.safeGetCityData(args.CITY, data => {
                return `${data.name}：${data.weather[0].description}，气温 ${data.main.temp}${this.tempUnit}，风速 ${data.wind.speed} ${this.windUnit}`;
            }, '无法获取天气数据');
        }

        async getTemperature(args) {
            return this.safeGetCityData(args.CITY, data => {
                return Math.round(data.main.temp) + this.tempUnit;
            }, '未知');
        }

        async getFeelsLike(args) {
            return this.safeGetCityData(args.CITY, data => {
                return Math.round(data.main.feels_like) + this.tempUnit;
            }, '未知');
        }

        async getWeatherCondition(args) {
            return this.safeGetCityData(args.CITY, data => data.weather[0].description, '未知');
        }

        async getWeatherIcon(args) {
            return this.safeGetCityData(args.CITY, data => data.weather[0].icon, '未知');
        }

        async getWindSpeed(args) {
            return this.safeGetCityData(args.CITY, data => data.wind.speed + ' ' + this.windUnit, '未知');
        }

        async getHumidity(args) {
            return this.safeGetCityData(args.CITY, data => data.main.humidity + '%', '未知');
        }

        async getPressure(args) {
            return this.safeGetCityData(args.CITY, data => data.main.pressure + ' hPa', '未知');
        }

        async getVisibility(args) {
            return this.safeGetCityData(args.CITY, data => {
                const vis = data.visibility;
                return vis >= 10000 ? '>10km' : vis + 'm';
            }, '未知');
        }

        async getSunrise(args) {
            return this.safeGetCityData(args.CITY, data => this.formatTime(data.sys.sunrise), '未知');
        }

        async getSunset(args) {
            return this.safeGetCityData(args.CITY, data => this.formatTime(data.sys.sunset), '未知');
        }

        async checkWeatherAlert(args) {
            try {
                const data = await this.fetchWeatherData(args.CITY);
                const condition = data.weather[0].description.toLowerCase();
                const windSpeed = data.wind.speed;
                return condition.includes('大风') || condition.includes('台风') || windSpeed > 14;
            } catch {
                return false;
            }
        }

        getRemainingQuota() {
            const quota = this.apiUsage.remaining;
            if (quota <= 5) return `仅剩 ${quota} 次，即将用完！`;
            return quota;
        }

        async getFullWeatherData(args) {
            try {
                const data = await this.fetchWeatherData(args.CITY);
                return JSON.stringify(data, null, 2);
            } catch (e) {
                return JSON.stringify({ error: e.message });
            }
        }

        async getWeatherByIP() {
            try {
                const ipRes = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(5000) });
                if (!ipRes.ok) return '无法定位城市';
                const ipData = await ipRes.json();
                const city = ipData.city || ipData.region;
                if (!city) return '无法识别城市';
                return await this.getWeather({ CITY: city });
            } catch (e) {
                return `定位失败：${e.message}`;
            }
        }

        setTemperatureUnit(args) {
            const unit = args.UNIT;
            if (unit === '华氏度') {
                this.units = 'imperial';
                this.tempUnit = '°F';
                this.windUnit = 'mph';
            } else {
                this.units = 'metric';
                this.tempUnit = '°C';
                this.windUnit = 'm/s';
            }
            this.cache.clear();
        }
    }

    Scratch.extensions.register(new WeatherAssistantExtension());
})(Scratch);
